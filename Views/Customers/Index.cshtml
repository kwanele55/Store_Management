@model IEnumerable<StoreManagement.Models.Customer>
@{
    ViewData["Title"] = "Customers";
}

<h2>Customers</h2>
<p><a asp-action="Create">Add New Customer</a></p>

<table class="table">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Registered Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.FirstName</td>
                <td>@c.LastName</td>
                <td>@c.Email</td>
                <td>@c.RegisteredDate.ToString("dd MMM yyyy")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@c.CustomerId">Details</a> |
                    <a asp-action="Edit" asp-route-id="@c.CustomerId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@c.CustomerId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>