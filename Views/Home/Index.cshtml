@{
    ViewData["Title"] = "Home";
}

<div class="container mt-4">

    <!-- Welcome Banner -->
    <div class="p-4 mb-4 bg-dark text-white rounded">
        <h1 class="display-6">Welcome to Store Management System</h1>
        <p class="mb-0">Manage your products, categories, customers and orders all in one place.</p>
    </div>

    <!-- Quick Access Cards -->
    <div class="row g-3">

        <div class="col-md-3 col-sm-6">
            <div class="card text-center h-100 shadow-sm">
                <div class="card-body">
                    <h1>📦</h1>
                    <h5 class="card-title">Products</h5>
                    <p class="card-text text-muted">View and manage all store products.</p>
                    <a asp-controller="Products" asp-action="Index"
                       class="btn btn-dark btn-sm">Go to Products</a>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card text-center h-100 shadow-sm">
                <div class="card-body">
                    <h1>🗂️</h1>
                    <h5 class="card-title">Categories</h5>
                    <p class="card-text text-muted">Organise products into categories.</p>
                    <a asp-controller="Categories" asp-action="Index"
                       class="btn btn-dark btn-sm">Go to Categories</a>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card text-center h-100 shadow-sm">
                <div class="card-body">
                    <h1>👤</h1>
                    <h5 class="card-title">Customers</h5>
                    <p class="card-text text-muted">View and manage customer records.</p>
                    <a asp-controller="Customers" asp-action="Index"
                       class="btn btn-dark btn-sm">Go to Customers</a>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card text-center h-100 shadow-sm">
                <div class="card-body">
                    <h1>🧾</h1>
                    <h5 class="card-title">Orders</h5>
                    <p class="card-text text-muted">Track and manage customer orders.</p>
                    <a asp-controller="Orders" asp-action="Index"
                       class="btn btn-dark btn-sm">Go to Orders</a>
                </div>
            </div>
        </div>

    </div>

</div>




















































































