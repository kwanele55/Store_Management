                <li class="list-group-item">🔍 LINQ used throughout all controllers for data queries</li>
            </ul>
        </div>
    </div>

    <!-- Back Button -->
    <a asp-controller="Home" asp-action="Index" class="btn btn-dark mb-4">
        ← Back to Home
